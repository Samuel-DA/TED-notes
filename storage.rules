rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isPairMember(pairId) {
      return request.auth != null
        && request.auth.uid in firestore.get(
          /databases/(default)/documents/pairs/$(pairId)
        ).data.members;
    }

    match /pairs/{pairId}/chatMedia/{ownerUid}/{fileName} {
      allow read: if isPairMember(pairId);
      allow create: if isPairMember(pairId)
        && request.auth.uid == ownerUid
        && fileName.matches('^[A-Za-z0-9_-]+[.][a-z0-9]+$')
        && (
          (request.resource.contentType.matches('image/.*') && request.resource.size <= 15 * 1024 * 1024)
          || (request.resource.contentType.matches('video/.*') && request.resource.size <= 50 * 1024 * 1024)
          // End-to-end encrypted photos/videos are uploaded as opaque ciphertext.
          || (request.resource.contentType == 'application/octet-stream' && request.resource.size <= 51 * 1024 * 1024)
        );
      allow update: if false;
      allow delete: if isPairMember(pairId) && request.auth.uid == ownerUid;
    }

    match /pairs/{pairId}/proofOfLife/{ownerUid}/{fileName} {
      allow read: if isPairMember(pairId);
      allow create: if isPairMember(pairId)
        && request.auth.uid == ownerUid
        && fileName.matches('^[A-Za-z0-9_-]+[.][a-z]+$')
        && request.resource.contentType.matches('image/.*')
        && request.resource.size <= 15 * 1024 * 1024;
      allow update: if false;
      allow delete: if isPairMember(pairId) && request.auth.uid == ownerUid;
    }

    match /pairs/{pairId}/voiceCapsules/{ownerUid}/{fileName} {
      allow read: if isPairMember(pairId);
      allow create: if isPairMember(pairId)
        && request.auth.uid == ownerUid
        && fileName.matches('^[A-Za-z0-9_-]+[.]m4a$')
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType.matches('audio/.*');
      allow update: if false;
      allow delete: if isPairMember(pairId)
        && request.auth.uid == ownerUid;
    }
  }
}
