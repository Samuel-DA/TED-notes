{
  "expo": {
    "name": "TED-Space",
    "slug": "TED-notes",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "tednotes",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.samuel.adebiyi.TEDnotes",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSFaceIDUsageDescription": "TED Space uses Face ID to securely lock your personal diary entries when backgrounded."
      }
    },
    "android": {
      "softwareKeyboardLayoutMode": "resize",
      "package": "com.samuel.adebiyi.TEDnotes",
      "versionCode": 1,
      "googleServicesFile": "./google-services.json",
      "predictiveBackGestureEnabled": false,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/icon.png",
        "backgroundImage": "./assets/images/icon.png",
        "monochromeImage": "./assets/images/icon.png"
      },
      "icon": "./assets/images/icon.png"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-notifications",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow TED Space to use Face ID to protect your private shared space."
        }
      ],
      "expo-web-browser",
      "expo-font",
      "expo-image",
      "expo-status-bar",
      [
        "expo-audio",
        {
          "microphonePermission": "Allow TED Space to record private voice comfort capsules for your partner."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a7e01892-f876-4e86-82be-4477844b0361"
      }
    },
    "owner": "samuel.adebiyi",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/a7e01892-f876-4e86-82be-4477844b0361"
    }
  }
}
